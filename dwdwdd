--============================================================
-- TARGET FINDER
--============================================================

local function GetClosestTarget()

	local Camera =
		Workspace.CurrentCamera

	if not Camera then
		return nil
	end

	local Viewport =
		Camera.ViewportSize

	local Center =
		Vector2.new(
			Viewport.X / 2,
			Viewport.Y / 2
		)

	local Closest = nil
	local ClosestDistance = math.huge

	for _, Player in ipairs(
		Players:GetPlayers()
	) do

		if Player ~= LocalPlayer then

			local Character =
				Player.Character

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			local Root =
				Character
				and Character:FindFirstChild(
					"HumanoidRootPart"
				)

			if Humanoid
				and Root
				and Humanoid.Health > 0 then

				local Position,
					OnScreen =
					Camera:WorldToViewportPoint(
						Root.Position
					)

				if OnScreen
					and Position.Z > 0 then

					local ScreenPosition =
						Vector2.new(
							Position.X,
							Position.Y
						)

					local Distance =
						(
							ScreenPosition
							- Center
						).Magnitude

					if Distance <= Settings.FOV
						and Distance < ClosestDistance then

						ClosestDistance = Distance
						Closest = Player

					end

				end
			end
		end
	end

	return Closest
end

--============================================================
-- AIM ASSIST
--============================================================

local function UpdateAim()

	if not Settings.AimAssist then
		return
	end

	local Camera =
		Workspace.CurrentCamera

	if not Camera then
		return
	end

	local Target =
		GetClosestTarget()

	if not Target then
		return
	end

	local Character =
		Target.Character

	local Root =
		Character
		and Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Root then
		return
	end

	local Desired =
		CFrame.lookAt(
			Camera.CFrame.Position,
			Root.Position
		)

	Camera.CFrame =
		Camera.CFrame:Lerp(
			Desired,
			Settings.Smoothness
		)
end

--============================================================
-- TRACKING LINES
--============================================================

local Lines = {}

local function GetLine(Player)

	if Lines[Player] then
		return Lines[Player]
	end

	local Line = Create("Frame", {
		Name = "TrackingLine",
		BackgroundColor3 = COLORS.PURPLE2,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Visible = false,
		ZIndex = 5
	}, GUI)

	Round(Line, 999)

	Lines[Player] = Line

	return Line
end

local function UpdateLine(Player)

	local Line =
		GetLine(Player)

	if not Settings.Tracking then

		Line.Visible = false

		return
	end

	local Camera =
		Workspace.CurrentCamera

	if not Camera then
		Line.Visible = false
		return
	end

	local Character =
		Player.Character

	local Root =
		Character
		and Character:FindFirstChild(
			"HumanoidRootPart"
		)

	local Humanoid =
		Character
		and Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not Root
		or not Humanoid
		or Humanoid.Health <= 0 then

		Line.Visible = false

		return
	end

	local Position,
		OnScreen =
		Camera:WorldToViewportPoint(
			Root.Position
		)

	if not OnScreen
		or Position.Z <= 0 then

		Line.Visible = false

		return
	end

	local Start =
		Vector2.new(
			Camera.ViewportSize.X / 2,
			Camera.ViewportSize.Y
		)

	local Finish =
		Vector2.new(
			Position.X,
			Position.Y
		)

	local Delta =
		Finish - Start

	Line.Position =
		UDim2.fromOffset(
			(Start.X + Finish.X) / 2,
			(Start.Y + Finish.Y) / 2
		)

	Line.Size =
		UDim2.fromOffset(
			Delta.Magnitude,
			2
		)

	Line.Rotation =
		math.deg(
			math.atan2(
				Delta.Y,
				Delta.X
			)
		)

	Line.Visible = true
end

--============================================================
-- HIGHLIGHTS
--============================================================

local Highlights = {}

local function UpdateHighlight(Player)

	local Character =
		Player.Character

	if not Character then
		return
	end

	if not Settings.Highlight
		and not Settings.ESP then

		if Highlights[Player] then
			Highlights[Player]:Destroy()
			Highlights[Player] = nil
		end

		return
	end

	local Highlight =
		Highlights[Player]

	if not Highlight then

		Highlight =
			Instance.new("Highlight")

		Highlight.Name =
			"VoidHighlight"

		Highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Highlight.FillColor =
			COLORS.PURPLE

		Highlight.FillTransparency =
			0.8

		Highlight.OutlineColor =
			COLORS.PURPLE2

		Highlight.Parent =
			Character

		Highlights[Player] =
			Highlight

	end

	Highlight.Adornee =
		Character
end

