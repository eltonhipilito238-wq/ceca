--============================================================

local function CreateCard(title)

	local Card = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundColor3 = COLORS.PANEL,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 12
	}, Content)

	Round(Card, 8)
	Outline(Card)

	local HeaderButton = Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 48),
		BackgroundTransparency = 1,
		Text = "",
		Active = true,
		ZIndex = 15
	}, Card)

	Create("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.fromOffset(13, 0),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.TEXT,
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 16
	}, HeaderButton)

	local Symbol = Create("TextLabel", {
		Size = UDim2.fromOffset(35, 48),
		Position = UDim2.new(1, -45, 0, 0),
		BackgroundTransparency = 1,
		Text = "+",
		TextColor3 = COLORS.SUB,
		TextSize = 16,
		Font = Enum.Font.Gotham,
		ZIndex = 16
	}, HeaderButton)

	local Body = Create("Frame", {
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.fromOffset(10, 53),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 14
	}, Card)

	local Layout = Instance.new("UIListLayout")
	Layout.Padding = UDim.new(0, 6)
	Layout.Parent = Body

	local opened = false

	local function Resize()
		if opened then
			Card.Size = UDim2.new(
				1,
				0,
				0,
				60 + Layout.AbsoluteContentSize.Y
			)
		else
			Card.Size = UDim2.new(
				1,
				0,
				0,
				48
			)
		end
	end

	HeaderButton.MouseButton1Click:Connect(function()

		opened = not opened

		Body.Visible = opened
		Symbol.Text = opened and "−" or "+"

		Resize()
	end)

	Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(Resize)

	return Body
end

