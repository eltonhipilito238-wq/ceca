local OriginalEffects = {}

local function SetPotatoGraphics(enabled)

	if enabled then

		Settings.PotatoGraphics = true

		Lighting.GlobalShadows = false

		for _, object in ipairs(
			Workspace:GetDescendants()
		) do

			if object:IsA("ParticleEmitter")
				or object:IsA("Trail")
				or object:IsA("Beam")
				or object:IsA("Smoke")
				or object:IsA("Fire")
				or object:IsA("Sparkles") then

				OriginalEffects[object] =
					object.Enabled

				object.Enabled = false

			end

		end

	else

		Settings.PotatoGraphics = false

		Lighting.GlobalShadows = true

		for object, enabledState in pairs(
			OriginalEffects
		) do

			if object
				and object.Parent then

				object.Enabled =
					enabledState

			end

		end

		table.clear(OriginalEffects)

	end

end

